{
  "name": "tlx-cloud-api",
  "version": "0.1.0",
  "description": "TLX Cloud API - Express.js backend for authentication, workspaces, scan ingestion, artifacts, reports, billing, and API monitoring.",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
    "check": "bun run build",
    "prisma:generate": "prisma generate",
    "build": "bun run prisma:generate && tsc --noEmit",
    "test": "bun test",
    "db:seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "tlx",
    "cloud",
    "api",
    "express",
    "saas",
    "scan",
    "report"
  ],
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
