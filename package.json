{
  "name": "tlx-cloud-api",
  "version": "0.1.0",
  "description": "TLX Cloud API - Express.js backend for authentication, workspaces, scan ingestion, artifacts, reports, billing, and API monitoring.",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
    "check": "bun --check index.ts",
    "build": "tsc --noEmit"
  },
  "keywords": [
    "tlx",
    "cloud",
    "api",
    "express",
    "saas",
    "scan",
    "report"
  ],
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "typescript": "^5.8.3"
  }
}
